POSTGRES_DB=sgqherbamed
POSTGRES_USER=sgqherbamed
POSTGRES_PASSWORD=troque_esta_senha

# OBRIGATORIO: o backend NAO inicia sem esta variavel.
# Em producao, use um segredo forte e aleatorio (ex.: openssl rand -hex 48).
JWT_SECRET=

# Chave exclusiva, somente leitura, para o almoxarifado consultar /api/integrations/rncs.
# Gere com: openssl rand -hex 48
RNC_INTEGRATION_API_KEY=
INITIAL_ADMIN_EMAIL=admin
INITIAL_ADMIN_PASSWORD=Herba@123
INITIAL_ADMIN_NAME=Administrador SGQ

ANTHROPIC_API_KEY=

# Envio de e-mail — Fase 0 do plano em docs/PLANO_EMAIL_BACKEND.md.
# O envio saiu do navegador; estas credenciais nao ficam mais no bundle JavaScript.
# emailjs = transporte atual | graph = Microsoft 365 (Fase 1) | log = nao envia (local/teste)
EMAIL_TRANSPORTE=emailjs
# ATENCAO: esta conta EmailJS deve ser considerada COMPROMETIDA — a public key
# esteve publicada no bundle desde o primeiro deploy. Encerrar ao fim da Fase 1.
EMAILJS_SERVICE_ID=service_gxhicii
EMAILJS_TEMPLATE_ID=template_4jl73wq
EMAILJS_PUBLIC_KEY=z2VxJ1dYjwrRp8Nh4
# OBRIGATORIA agora que o envio saiu do navegador: sem ela a API responde 403.
# Painel do EmailJS -> Account -> General (Private Key). Alem disso, ligar
# "Allow EmailJS API for non-browser applications" em Account -> Security.
EMAILJS_PRIVATE_KEY=
# Limite por usuario: conta destinatarios, nao requisicoes.
EMAIL_RATE_LIMIT_MAX=200
EMAIL_RATE_LIMIT_JANELA_MS=3600000
EMAIL_MAX_DESTINATARIOS=50

# Uploads/anexos ficam no PostgreSQL local.
# Padrao: 50MB por arquivo. Como o envio usa base64 em JSON,
# o limite do corpo HTTP precisa ser maior que o arquivo cru.
FILE_UPLOAD_MAX_BYTES=52428800
JSON_BODY_LIMIT_BYTES=80000000

# Resumo local de POPs/documentos. O conteudo permanece dentro do Docker.
# Limites de leitura automatica: 25MB, 180 mil caracteres e 80 paginas por arquivo.
DOCUMENT_SUMMARY_MAX_FILE_BYTES=26214400
DOCUMENT_SUMMARY_MAX_TEXT_CHARS=180000
DOCUMENT_SUMMARY_MAX_PAGES=80

# Backup automatico do PostgreSQL dentro do Docker.
# Padrao: 1 dump por dia, retencao de 30 dias.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30

# Areco: somente leitura. Nao gravar nada no banco do ERP.
ARECO_SYNC_ENABLED=true
ARECO_SYNC_INTERVAL_MS=180000
ARECO_RECEBIMENTOS_LIMIT=1000
ARECO_RECEBIMENTOS_DAYS=7
ARECO_FORNECEDORES_LIMIT=5000
ARECO_FORNECEDORES_YEARS=5
ARECO_SQLSERVER_HOST=10.0.242.230
ARECO_SQLSERVER_PORT=5327
ARECO_SQLSERVER_DATABASE=VSatHerbamed
ARECO_SQLSERVER_USER=fabiano.alves
ARECO_SQLSERVER_PASSWORD=

# Opcional: sobrescreve as consultas padrao do Areco sem alterar o codigo.
ARECO_RECEBIMENTOS_QUERY=
ARECO_MATERIAIS_QUERY=
# Opcional: 0/vazio importa todos os materiais encontrados.
ARECO_MATERIAIS_LIMIT=0
